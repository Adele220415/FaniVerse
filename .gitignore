# ============================================================================
# SECRETS - never commit these. Listed first so they are easy to audit.
# ============================================================================

# Firebase Admin private key. Grants full admin access to the project.
# Generate a new one in Firebase console > Project Settings > Service Accounts.
serviceAccountKey.json
*serviceAccountKey*.json
*-service-account*.json
*-firebase-adminsdk*.json

# Signing keys - these let someone publish builds as you.
*.jks
*.keystore
key.properties
android/key.properties
**/android/key.properties

# Local env / secrets
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
secrets.dart
secret.dart

# Machine-specific / personal overrides
local.properties
.claude/
.vscode/settings.json
*.local

# ============================================================================
# DEPENDENCIES
# ============================================================================
node_modules/
.pnp
.pnp.js
npm-debug.log*
yarn-error.log*

# ============================================================================
# FLUTTER / DART
# ============================================================================
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
build/
coverage/

# Symbolication / obfuscation output
app.*.symbols
app.*.map.json

