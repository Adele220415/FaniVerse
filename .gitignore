# ============================================================================
# SEED DATA PIPELINE
# ============================================================================
# Generated JSON is intentionally COMMITTED so it stays diffable in review.
# Local API cache and credentials are not.
/seed/.env
/seed/.cache/
/seed/node_modules/
/seed/*.log

