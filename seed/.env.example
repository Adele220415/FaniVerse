# Copy to seed/.env and fill in ONE of the two keys. .env is gitignored.
#
# Provider is auto-detected: UNSPLASH_ACCESS_KEY wins, then PEXELS_API_KEY.
# With neither set, generate.mjs falls back to picsum.photos placeholders.
#
#   Unsplash: https://unsplash.com/developers  -> "Access Key"
#   Pexels:   https://www.pexels.com/api/      -> API Key

UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Force a provider instead of auto-detecting: unsplash | pexels | picsum
# IMAGE_PROVIDER=

# Photos fetched per category (1 request per category per run, then cached).
# Unsplash's free tier allows 50 req/hour, so keep this modest.
IMAGE_POOL_SIZE=30
